{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":semanticCommits", "helpers:pinGitHubActionDigests"],
  "timezone": "Asia/Tokyo",
  "schedule": ["before 9am on monday"],
  "labels": ["dependencies"],
  "prConcurrentLimit": 10,
  "minimumReleaseAge": "3 days",
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 9am on monday"]
  },
  "packageRules": [
    {
      "description": "Group non-major npm/catalog updates into one consolidated PR; majors stay separate for a careful look.",
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "groupName": "npm (minor & patch)"
    },
    {
      "description": "GitHub Actions land together and keep their commit-SHA pin + trailing version comment.",
      "matchManagers": ["github-actions"],
      "groupName": "github-actions",
      "addLabels": ["ci"],
      "semanticCommitType": "ci"
    }
  ]
}
