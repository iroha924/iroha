{
  "name": "iroha",
  "private": true,
  "license": "Apache-2.0",
  "packageManager": "pnpm@11.14.0",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "prepare": "lefthook install",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "lint:md": "markdownlint-cli2",
    "lint:packages": "sherif",
    "knip": "knip",
    "semgrep": "semgrep --config .semgrep/ --error .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:contracts": "turbo run test:contracts",
    "test:integration": "turbo run test:integration",
    "test:e2e": "turbo run test:e2e",
    "test:package": "turbo run test:package",
    "check:package": "pnpm build && pnpm --filter @iroha/plugin build:release && pnpm run check:package:validate",
    "check:package:validate": "publint packages/plugin/release && attw --pack packages/plugin/release",
    "size": "pnpm --filter @iroha/dashboard build && size-limit",
    "format": "biome format --write .",
    "changeset": "changeset",
    "cz": "czg",
    "deps:check": "taze -r",
    "dashboard": "pnpm build && node packages/cli/dist/bin.mjs dashboard",
    "dashboard:api": "pnpm build && IROHA_DASHBOARD_DEV_TOKEN=iroha-dev node packages/cli/dist/bin.mjs dashboard --port 5178 --no-open",
    "dashboard:web": "pnpm --filter @iroha/dashboard dev",
    "link:global": "pnpm build && cd packages/plugin && pnpm link --global"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "catalog:",
    "@biomejs/biome": "catalog:",
    "@changesets/cli": "catalog:",
    "@commitlint/cli": "catalog:",
    "@commitlint/config-conventional": "catalog:",
    "@size-limit/file": "catalog:",
    "czg": "catalog:",
    "knip": "catalog:",
    "lefthook": "catalog:",
    "markdownlint-cli2": "catalog:",
    "publint": "catalog:",
    "sherif": "catalog:",
    "size-limit": "catalog:",
    "taze": "catalog:",
    "turbo": "2.10.5"
  }
}
